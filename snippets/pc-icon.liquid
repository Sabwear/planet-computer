    {% when 'search' %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>
    {% when 'cart' %}<path d="M3 3h2l3 13h11l2-9H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/>
    {% when 'account' %}<circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/>
    {% when 'menu' %}<path d="M3 6h18M3 12h18M3 18h18"/>
    {% when 'close' %}<path d="m6 6 12 12M6 18 18 6"/>
    {% when 'chevron' %}<path d="m9 5 7 7-7 7"/>
    {% when 'filter' %}<path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="2"/><circle cx="15" cy="17" r="2"/>
