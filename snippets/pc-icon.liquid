    {% when 'plus' %}<path d="M12 5v14M5 12h14"/>
    {% when 'email' %}<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m3 6 9 7 9-7"/>
    {% when 'location' %}<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/>
