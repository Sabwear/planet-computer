<article class="pc-blog-card"><a class="pc-blog-card__image" href="{{ post.url }}" tabindex="-1" aria-hidden="true">{% if post.image != blank %}{{ post.image | image_url: width: 900 | image_tag: widths: '350, 600, 900', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: post.image.alt }}{% else %}<img src="{{ 'pc-editorial-home-office.jpg' | asset_url }}" width="1536" height="1024" alt="" loading="lazy">{% endif %}</a><div class="pc-blog-card__body"><div class="pc-blog-card__meta">{% if post.tags.size > 0 %}<span>{{ post.tags.first | escape }}</span>{% endif %}<time datetime="{{ post.published_at | date: '%Y-%m-%d' }}">{{ post.published_at | date: '%d/%m/%Y' }}</time></div><h2><a href="{{ post.url }}">{{ post.title | escape }}</a></h2><p>{{ post.excerpt_or_content | strip_html | truncatewords: 28 }}</p><a class="pc-blog-card__read" href="{{ post.url }}">Lire le conseil <span class="visually-hidden">: {{ post.title | escape }}</span>{% render 'pc-icon', name: 'chevron' %}</a></div></article>
