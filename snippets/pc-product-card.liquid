{% if product != blank %}
  {% liquid
    assign variant = product.selected_or_first_available_variant
    assign safe_quick_add = false
    if product.variants.size == 1 and variant.available and product.requires_selling_plan == false
      if variant.quantity_rule.min <= 1 and variant.quantity_rule.increment <= 1 and product.quantity_price_breaks_configured? != true
        assign safe_quick_add = true
      endif
    endif
  %}
  <article class="pc-product-card">
    <div class="pc-product-card__media">
    <a class="pc-product-card__image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {% if product.featured_image != blank %}{% render 'responsive-image', image: product.featured_image, alt: product.title, image_class: 'pc-product-image' %}
      {% else %}<span class="pc-missing-image">{% render 'pc-icon', name: 'image' %}<span>{{ 'pc.product.image_unavailable' | t }}</span></span>{% endif %}
    </a>
    {% render 'product-badges', product: product %}
    <button type="button" class="pc-quick-view-trigger" data-pc-quick-view="{{ product.url }}" {% if show_price == false %}data-hide-price{% endif %} aria-label="{{ 'pc.product.quick_view_named' | t: title: product.title | escape }}" hidden>{{ 'pc.product.quick_view' | t }}</button>
    </div>
    <div class="pc-product-card__content">
      {% if product.vendor != blank and product.vendor != shop.name and product.vendor != 'My Store' %}<p class="pc-product-card__vendor">{{ product.vendor | escape }}</p>{% endif %}
      <h3 class="pc-product-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
      {% if product.type != blank %}<p class="pc-product-card__type">{{ product.type | escape }}</p>{% endif %}
      {% render 'specs-chips', product: product, mode: mode %}
      <div class="pc-product-card__purchase">
        {% unless show_price == false %}{% render 'pc-price', product: product %}{% endunless %}
        {% render 'pc-availability', variant: variant %}
        {% if quick_add %}
          {% if safe_quick_add %}
            {% render 'pc-card-add', product: product, variant: variant %}
          {% elsif product.available %}<a class="pc-button pc-button--secondary" href="{{ product.url }}">{{ 'pc.product.options' | t }}</a>
          {% else %}<a class="pc-button pc-button--secondary" href="{{ product.url }}">{{ 'pc.product.view' | t }}</a>{% endif %}
        {% endif %}
      </div>
    </div>
  </article>
{% endif %}
