{% assign logo_brands = '' %}{% assign text_brands = '' %}
{% for vendor in shop.vendors %}{% if vendor != blank and vendor != shop.name and vendor != 'My Store' %}
{% assign brand_key = vendor | downcase | strip %}{% assign brand_logo = '' %}
{% case brand_key %}{% when 'acer' %}{% assign brand_logo = 'pc-brand-acer.svg' %}{% when 'asus' %}{% assign brand_logo = 'pc-brand-asus.png' %}{% when 'microsoft' %}{% assign brand_logo = 'pc-brand-microsoft.png' %}{% when 'msi' %}{% assign brand_logo = 'pc-brand-msi.png' %}{% when 'dell' %}{% assign brand_logo = 'pc-brand-dell.png' %}{% when 'hp' %}{% assign brand_logo = 'pc-brand-hp.svg' %}{% when 'lenovo' %}{% assign brand_logo = 'pc-brand-lenovo.png' %}{% endcase %}
{% capture brand_item %}<li><a href="{{ routes.root_url }}collections/vendors?q={{ vendor | url_encode }}">{% if brand_logo != blank %}<img src="{{ brand_logo | asset_url }}" alt="{{ vendor | escape }}" width="120" height="44" loading="lazy">{% else %}{{ vendor | escape }}{% endif %}</a></li>{% endcapture %}
{% if brand_logo != blank %}{% assign logo_brands = logo_brands | append: brand_item %}{% else %}{% assign text_brands = text_brands | append: brand_item %}{% endif %}
{% endif %}{% endfor %}
{% capture catalog_brands %}{{ logo_brands }}{{ text_brands }}{% endcapture %}
{% if catalog_brands != blank %}
{{ 'homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'carousel.js' | asset_url }}" defer="defer"></script>
<section class="pc-section pc-catalog-brands" style="padding-block: {{ section.settings.spacing }}px"><div class="pc-container">
<h2 class="pc-section-heading">{{ section.settings.heading | escape }}</h2>
<pc-carousel><div class="pc-carousel__controls" data-controls hidden><button type="button" data-prev aria-label="{{ 'pc.home.previous' | t }}" aria-controls="PCBrands-{{ section.id }}">{% render 'pc-icon', name: 'chevron' %}</button><button type="button" data-next aria-label="{{ 'pc.home.next' | t }}" aria-controls="PCBrands-{{ section.id }}">{% render 'pc-icon', name: 'chevron' %}</button></div><ul id="PCBrands-{{ section.id }}" class="pc-catalog-brands__list" role="list" data-row tabindex="0">{{ catalog_brands }}</ul></pc-carousel>
</div></section>
{% endif %}
{% schema %}
{"name":"Marques du catalogue","settings":[{"type":"text","id":"heading","label":"Titre","default":"Explorez par marque."},{"type":"range","id":"spacing","label":"Espacement","min":16,"max":64,"step":8,"default":24}],"presets":[{"name":"Marques du catalogue"}]}
{% endschema %}
