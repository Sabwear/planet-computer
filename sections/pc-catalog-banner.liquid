{{ 'product.css' | asset_url | stylesheet_tag }}
{% liquid
 assign banner_title = section.settings.heading
 if template.name == 'collection'
  assign banner_title = collection.title
 endif
 assign banner_image = section.settings.image
 if banner_image == blank and collection.image != blank
  assign banner_image = collection.image
 endif
%}
<section class="pc-catalog-banner"><div class="pc-container"><div class="pc-catalog-banner__inner"><div class="pc-catalog-banner__copy">
{% render 'pc-breadcrumbs', collection: collection %}
<h1>{{ banner_title | default: 'Collections' | escape }}</h1>
{% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
{% if section.settings.show_description and collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}
</div>
{% if banner_image != blank %}{{ banner_image | image_url: width: 1000 | image_tag: loading: 'eager', widths: '400, 600, 1000', sizes: '(min-width: 768px) 40vw, 90vw', class: 'pc-catalog-banner__image pc-catalog-banner__image--collection', alt: banner_title }}{% else %}<img class="pc-catalog-banner__image" src="{{ 'pc-editorial-home-office.jpg' | asset_url }}" width="1536" height="1024" alt="">{% endif %}
</div><nav class="pc-catalog-links" aria-label="{{ 'pc.shell.explore_categories' | t }}">{% for item in collections %}{% if item.products_count > 0 and item.handle != 'all' %}<a href="{{ item.url }}"{% if collection.handle == item.handle %} aria-current="page"{% endif %}>{{ item.title | escape }}</a>{% endif %}{% endfor %}</nav></div></section>
{% schema %}{"name":"Bannière catalogue","settings":[{"type":"text","id":"heading","label":"Titre de la page catégories","default":"Explorez nos univers."},{"type":"text","id":"text","label":"Texte","default":"Comparez les équipements et trouvez la configuration adaptée à votre usage."},{"type":"image_picker","id":"image","label":"Image de bannière (prioritaire)"},{"type":"checkbox","id":"show_description","label":"Description de la collection","default":true}],"presets":[{"name":"Bannière catalogue"}]}{% endschema %}
