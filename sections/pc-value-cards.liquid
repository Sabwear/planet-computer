{{ 'homepage.css' | asset_url | stylesheet_tag }}
{% assign visible_cards = 0 %}
{% for block in section.blocks %}
  {% if block.settings.heading != blank and block.settings.text != blank %}
    {% assign visible_cards = visible_cards | plus: 1 %}
  {% endif %}
{% endfor %}
{% if visible_cards > 0 %}
  <section class="pc-section pc-value-cards" style="padding-block: {{ section.settings.spacing }}px">
    <div class="pc-container">
      <div class="pc-value-cards__intro pc-stack">
        {% if section.settings.eyebrow != blank %}<p class="pc-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2 class="pc-section-heading">{{ section.settings.heading | escape }}</h2>{% endif %}
        {% if section.settings.text != blank %}<div class="pc-muted rte">{{ section.settings.text }}</div>{% endif %}
      </div>
      <ul class="pc-value-cards__grid" role="list">
        {% for block in section.blocks %}
          {% if block.settings.heading != blank and block.settings.text != blank %}
            <li class="pc-value-card" {{ block.shopify_attributes }}>
              <div class="pc-value-card__icon" aria-hidden="true">{% render 'pc-icon', name: block.settings.icon %}</div>
              <div class="pc-stack">
                <h3>{{ block.settings.heading | escape }}</h3>
                <div class="pc-muted rte">{{ block.settings.text }}</div>
                {% if block.settings.link_label != blank and block.settings.link != blank %}
                  <a class="pc-text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}{% render 'pc-icon', name: 'chevron' %}</a>
                {% endif %}
              </div>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </section>
{% endif %}
{% schema %}
{
  "name": "Repères Planet Computer",
  "max_blocks": 6,
  "settings": [
    {"type":"text","id":"eyebrow","label":"Surtitre","default":"POUR AVANCER SEREINEMENT"},
    {"type":"text","id":"heading","label":"Titre","default":"Un équipement pensé pour votre usage."},
    {"type":"richtext","id":"text","label":"Introduction","default":"<p>Commencez par votre besoin, comparez les informations utiles et avancez avec une sélection claire.</p>"},
    {"type":"range","id":"spacing","label":"Espacement","min":16,"max":64,"step":8,"default":32}
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Repère",
      "settings": [
        {"type":"select","id":"icon","label":"Icône","default":"search","options":[{"value":"search","label":"Recherche"},{"value":"laptop","label":"Ordinateur portable"},{"value":"desktop","label":"Ordinateur de bureau"},{"value":"monitor","label":"Moniteur"},{"value":"gaming","label":"Gaming"},{"value":"storage","label":"Stockage"},{"value":"phone","label":"Téléphone"}]},
        {"type":"text","id":"heading","label":"Titre"},
        {"type":"richtext","id":"text","label":"Texte"},
        {"type":"text","id":"link_label","label":"Libellé du lien"},
        {"type":"url","id":"link","label":"Lien"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Repères Planet Computer",
      "blocks": [
        {"type":"value","settings":{"icon":"search","heading":"Commencez par votre usage","text":"<p>Travail, création, mobilité ou gaming : le bon équipement dépend d’abord de ce que vous voulez faire.</p>"}},
        {"type":"value","settings":{"icon":"storage","heading":"Comparez les configurations","text":"<p>Processeur, mémoire, stockage, écran et connectique : retrouvez les critères utiles sur chaque fiche produit.</p>"}},
        {"type":"value","settings":{"icon":"desktop","heading":"Explorez par univers","text":"<p>Parcourez les ordinateurs portables, PC de bureau, moniteurs, accessoires et imprimantes.</p>","link_label":"Voir le catalogue","link":"shopify://collections/all"}},
        {"type":"value","settings":{"icon":"phone","heading":"Une question sur un produit ?","text":"<p>Transmettez-nous votre besoin ou une référence pour obtenir une réponse adaptée à votre projet.</p>","link_label":"Nous contacter","link":"shopify://pages/contact"}}
      ]
    }
  ]
}
{% endschema %}
