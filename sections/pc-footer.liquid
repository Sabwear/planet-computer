{{ 'footer.css' | asset_url | stylesheet_tag }}
<footer class="pc-footer pc-section">
  <div class="pc-container">
    <div class="pc-footer__grid">
      <div class="pc-footer__brand pc-stack">
        <a class="pc-brand" href="{{ routes.root_url }}">{{ settings.pc_brand_name | default: shop.name | escape }}</a>
        {% if section.settings.description != blank %}<p class="pc-muted">{{ section.settings.description | escape }}</p>{% endif %}
        {% if settings.pc_address != blank %}<p>{{ settings.pc_address | escape | newline_to_br }}</p>{% endif %}
        {% if settings.pc_contact_email != blank %}<a href="mailto:{{ settings.pc_contact_email | escape }}">{{ settings.pc_contact_email | escape }}</a>{% endif %}
        {% if settings.pc_contact_phone != blank %}<a href="tel:{{ settings.pc_contact_phone | remove: ' ' | escape }}">{{ settings.pc_contact_phone | escape }}</a>{% endif %}
        {% if settings.social_facebook_link != blank %}<a href="{{ settings.social_facebook_link }}">{{ 'pc.shell.facebook' | t }}</a>{% endif %}
      </div>
      {% if section.settings.catalog_links %}<div><h2 class="pc-footer__heading">Explorer</h2><ul class="pc-footer__links" role="list"><li><a href="{{ routes.all_products_collection_url }}">Tous les produits</a></li><li><a href="{{ routes.search_url }}?q=portable&amp;type=product">PC portables</a></li><li><a href="{{ routes.search_url }}?q=moniteur&amp;type=product">Moniteurs & accessoires</a></li></ul></div>{% endif %}
      {% if section.settings.contact_link != blank %}<div><h2 class="pc-footer__heading">Votre projet</h2><ul class="pc-footer__links" role="list"><li><a href="{{ section.settings.contact_link }}">Nous contacter</a></li>{% if section.settings.guide_link != blank %}<li><a href="{{ section.settings.guide_link }}">Guide d’achat</a></li>{% endif %}<li><a href="{{ routes.cart_url }}">Mon panier</a></li></ul></div>{% endif %}
      {% for block in section.blocks %}
        {% if block.settings.menu.links != blank %}
          <div {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}<h2 class="pc-footer__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
            <ul class="pc-footer__links" role="list">{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="pc-footer__bottom">
      <small>&copy; {{ 'now' | date: '%Y' }} {{ settings.pc_brand_name | default: shop.name | escape }}</small>
      {% if shop.policies.size > 0 %}<ul class="pc-footer__policies" role="list">{% for policy in shop.policies %}{% if policy != blank %}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{% endif %}{% endfor %}</ul>{% endif %}
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Pied Planet Computer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "max_blocks": 3,
  "settings": [{"type":"url","id":"guide_link","label":"Lien du guide d’achat"},{"type":"text","id":"description","label":"Présentation"},{"type":"checkbox","id":"catalog_links","label":"Liens du catalogue","default":false},{"type":"url","id":"contact_link","label":"Page de contact"},
    {
      "type": "paragraph",
      "content": "Coordonnées et Facebook sont centralisés dans les paramètres du thème. Les politiques proviennent de Shopify."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Colonne de liens",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pied Planet Computer"
    }
  ],
  "limit": 1
}
{% endschema %}
