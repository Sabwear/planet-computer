{{ 'product.css' | asset_url | stylesheet_tag }}
<section class="pc-section pc-product-information" style="padding-block: {{ section.settings.spacing }}px"><div class="pc-container pc-product-information__grid">
  {% if product.description != blank %}<details class="pc-product-description" open><summary>{{ 'pc.product.description' | t }}</summary><div class="rte">{{ product.description }}</div></details>{% endif %}
  <div>{% render 'pc-product-specifications', product: product %}</div>
</div></section>
