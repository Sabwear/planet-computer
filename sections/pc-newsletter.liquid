{% if section.settings.enabled and section.settings.heading != blank %}
  {{ 'homepage.css' | asset_url | stylesheet_tag }}
  <section class="pc-section" style="padding-block: {{ section.settings.spacing }}px"><div class="pc-container"><div class="pc-newsletter pc-stack">
    <h2>{{ section.settings.heading | escape }}</h2>
    {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
    {% assign form_id = 'PCNewsletter-' | append: section.id %}
    {% form 'customer', id: form_id %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="pc-newsletter__row"><label class="visually-hidden" for="PCEmail-{{ section.id }}">{{ 'pc.home.email' | t }}</label><input id="PCEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email | escape }}" required autocomplete="email" placeholder="{{ 'pc.home.email' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="PCNewsletterError-{{ section.id }}"{% endif %}><button class="pc-button" type="submit">{{ 'pc.home.subscribe' | t }}</button></div>
      <label class="pc-newsletter__consent"><input type="checkbox" name="contact[accepts_marketing]" value="true" required>{{ 'pc.home.consent' | t }}</label>
      {% if shop.privacy_policy != blank %}<a class="pc-text-link" href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a>{% endif %}
      {% if form.errors %}<div id="PCNewsletterError-{{ section.id }}" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      {% if form.posted_successfully? %}<p role="status">{{ 'pc.home.subscribed' | t }}</p>{% endif %}
    {% endform %}
  </div></div></section>
{% endif %}
{% schema %}
{
  "name": "Newsletter Planet",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Stratégie e-mail approuvée",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Espacement",
      "min": 16,
      "max": 64,
      "step": 8,
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Newsletter Planet"
    }
  ]
}
{% endschema %}
