{{ 'homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'carousel.js' | asset_url }}" defer="defer"></script>
{% capture reviews %}{% for block in section.blocks %}{% if block.type == '@app' %}<div class="pc-review">{% render block %}</div>{% elsif block.settings.confirmed and block.settings.quote != blank and block.settings.author != blank %}<article class="pc-review" {{ block.shopify_attributes }}>{% if block.settings.rating > 0 %}<p class="pc-review-rating">{{ block.settings.rating }} / 5</p>{% endif %}<blockquote>{{ block.settings.quote | escape }}</blockquote><cite>{{ block.settings.author | escape }}</cite>{% if block.settings.date != blank %}<p class="pc-muted">{{ block.settings.date | escape }}</p>{% endif %}</article>{% endif %}{% endfor %}{% endcapture %}
<section class="pc-section pc-reviews" style="padding-block: {{ section.settings.spacing }}px"><div class="pc-container"><div class="pc-reviews__intro"><div><h2 class="pc-section-heading">{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}</div>{% if section.settings.button_label != blank and section.settings.button_link != blank %}<a class="pc-button pc-button--secondary" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div>{% if reviews != blank %}<pc-carousel><div class="pc-carousel__controls" data-controls hidden><button type="button" data-prev aria-label="{{ 'pc.home.previous' | t }}" aria-controls="PCReviews-{{ section.id }}">{% render 'pc-icon', name: 'chevron' %}</button><button type="button" data-next aria-label="{{ 'pc.home.next' | t }}" aria-controls="PCReviews-{{ section.id }}">{% render 'pc-icon', name: 'chevron' %}</button></div><div id="PCReviews-{{ section.id }}" class="pc-brands" data-row tabindex="0">{{ reviews }}</div></pc-carousel>{% endif %}</div></section>
{% schema %}{"name":"Avis clients","settings":[{"type":"text","id":"heading","label":"Titre","default":"Votre expérience compte."},{"type":"text","id":"text","label":"Texte","default":"Partagez votre expérience avec Planet Computer."},{"type":"text","id":"button_label","label":"Bouton","default":"Partager mon expérience"},{"type":"url","id":"button_link","label":"Lien vers avis ou contact"},{"type":"range","id":"spacing","label":"Espacement","min":16,"max":64,"step":8,"default":32}],"blocks":[{"type":"@app"},{"type":"review","name":"Avis réel confirmé","settings":[{"type":"checkbox","id":"confirmed","label":"Avis authentique et publication autorisée","default":false},{"type":"textarea","id":"quote","label":"Avis"},{"type":"text","id":"author","label":"Nom autorisé du client"},{"type":"text","id":"date","label":"Date ou contexte"},{"type":"range","id":"rating","label":"Note réelle (0 pour masquer)","min":0,"max":5,"step":1,"default":0}]}],"presets":[{"name":"Avis clients"}]}{% endschema %}
