{% if section.blocks.size > 0 %}
  {{ 'homepage.css' | asset_url | stylesheet_tag }}
  <section class="pc-section" style="padding-block: {{ section.settings.spacing }}px">
    <div class="pc-container">
      {% if section.settings.heading != blank %}<h2 class="pc-section-heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      <ul class="pc-categories" role="list">
        {% for block in section.blocks %}
          {% assign category_url = block.settings.collection.url | default: block.settings.link %}
          {% if category_url != blank %}
            {% assign category_image = block.settings.image | default: block.settings.collection.image %}
            <li {{ block.shopify_attributes }}><a href="{{ category_url }}">
              {% if category_image != blank %}<span class="pc-category-image">{% render 'responsive-image', image: category_image, alt: '', decorative: true, sizes: '120px', image_class: 'pc-product-image' %}</span>{% else %}{% if section.settings.photographic_categories %}<span class="pc-category-image"><img src="{% if block.settings.icon == 'printer' %}{{ 'pc-product-58031561-1.jpg' | asset_url }}{% else %}{{ 'pc-category-' | append: block.settings.icon | append: '.webp' | asset_url }}{% endif %}" width="256" height="256" alt="" loading="lazy"></span>{% else %}<span class="pc-category-image pc-category-icon">{% render 'pc-icon', name: block.settings.icon %}</span>{% endif %}{% endif %}
              <span>{{ block.settings.label | default: block.settings.collection.title | escape }}</span>
            </a></li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </section>
{% endif %}
{% schema %}
{"name":"Catégories Planet","max_blocks":12,"settings":[{"type":"checkbox","id":"photographic_categories","label":"Photographies illustratives des catégories","default":false},{"type":"text","id":"heading","label":"Titre"},{"type":"range","id":"spacing","label":"Espacement","min":16,"max":64,"step":8,"default":24}],"blocks":[{"type":"category","name":"Catégorie","settings":[{"type":"url","id":"link","label":"Lien alternatif"},{"type":"select","id":"icon","label":"Icône","default":"laptop","options":[{"value":"laptop","label":"Portable"},{"value":"desktop","label":"Bureau"},{"value":"gaming","label":"Gaming"},{"value":"monitor","label":"Écran"},{"value":"keyboard","label":"Accessoires"},{"value":"storage","label":"Stockage"},{"value":"printer","label":"Imprimantes"}]},{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"label","label":"Libellé personnalisé"},{"type":"image_picker","id":"image","label":"Image"}]}],"presets":[{"name":"Catégories Planet"}]}
{% endschema %}
