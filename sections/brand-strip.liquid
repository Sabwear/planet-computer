{% capture brand_items %}{% for block in section.blocks %}{% if block.settings.confirmed and block.settings.name != blank %}
  <li {{ block.shopify_attributes }}>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
    {% if block.settings.image != blank %}{% render 'responsive-image', image: block.settings.image, alt: block.settings.name, sizes: '120px', image_class: 'pc-brand-image' %}{% else %}<span>{{ block.settings.name | escape }}</span>{% endif %}
  {% if block.settings.link != blank %}</a>{% endif %}</li>
{% endif %}{% endfor %}{% endcapture %}
{% if brand_items != blank %}
  {{ 'homepage.css' | asset_url | stylesheet_tag }}
  <section class="pc-section" style="padding-block: {{ section.settings.spacing }}px"><div class="pc-container">
    {% if section.settings.heading != blank %}<h2 class="pc-section-heading">{{ section.settings.heading | escape }}</h2>{% endif %}
    <ul class="pc-brands" role="list">{{ brand_items }}</ul>
  </div></section>
{% endif %}
{% schema %}
{"name":"Marques Planet","max_blocks":12,"settings":[{"type":"text","id":"heading","label":"Titre"},{"type":"range","id":"spacing","label":"Espacement","min":16,"max":64,"step":8,"default":16}],"blocks":[{"type":"brand","name":"Marque","settings":[{"type":"text","id":"name","label":"Nom"},{"type":"image_picker","id":"image","label":"Logo autorisé"},{"type":"url","id":"link","label":"Lien"},{"type":"checkbox","id":"confirmed","label":"Marque vendue confirmée","default":false}]}],"presets":[{"name":"Marques Planet"}]}
{% endschema %}
