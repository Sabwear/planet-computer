{{ 'homepage.css' | asset_url | stylesheet_tag }}
<section class="pc-section pc-shop-use" style="padding-block: {{ section.settings.spacing }}px">
  <div class="pc-container">
    {% if section.settings.heading != blank %}<h2 class="pc-section-heading">{{ section.settings.heading | escape }}</h2>{% endif %}
    <div class="pc-shop-use__grid">
      {% for block in section.blocks %}{% if block.settings.link != blank %}
        <article class="pc-use-tile" {{ block.shopify_attributes }}>
          <a class="pc-use-tile__image" href="{{ block.settings.link }}" aria-label="{{ block.settings.heading | escape }}">
            {% if block.settings.image != blank %}{% render 'responsive-image', image: block.settings.image, decorative: true, image_class: 'pc-use-photo', sizes: '(min-width: 768px) 45vw, 90vw' %}
            {% else %}{% assign use_asset = 'pc-editorial-home-office.jpg' %}{% if block.settings.scene == 'gaming' %}{% assign use_asset = 'pc-retail-gaming.webp' %}{% endif %}<img class="pc-use-photo" src="{{ use_asset | asset_url }}" width="1536" height="1024" alt="" loading="lazy">{% endif %}
          </a>
          <div class="pc-use-tile__content">
            {% if block.settings.eyebrow != blank %}<p class="pc-eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
            <h3>{{ block.settings.heading | escape }}</h3>
            {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
            <a class="pc-text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}{% render 'pc-icon', name: 'chevron' %}</a>
          </div>
        </article>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Équiper votre quotidien","max_blocks":4,"settings":[{"type":"text","id":"heading","label":"Titre","default":"À chaque usage, son équipement."},{"type":"range","id":"spacing","label":"Espacement","min":16,"max":64,"step":8,"default":24}],"blocks":[{"type":"use","name":"Univers illustré","settings":[{"type":"image_picker","id":"image","label":"Photo personnalisée"},{"type":"select","id":"scene","label":"Illustration de secours","default":"office","options":[{"value":"office","label":"Bureau"},{"value":"gaming","label":"Gaming"}]},{"type":"text","id":"eyebrow","label":"Surtitre"},{"type":"text","id":"heading","label":"Titre"},{"type":"text","id":"text","label":"Texte"},{"type":"text","id":"link_label","label":"Libellé du lien","default":"Explorer"},{"type":"url","id":"link","label":"Lien"}]}],"presets":[{"name":"Équiper votre quotidien"}]}
{% endschema %}
