{{ 'pc-editorial.css' | asset_url | stylesheet_tag }}
<section class="pc-section"><div class="pc-container"><div class="pc-legal"><nav class="pc-editorial__breadcrumb" aria-label="Fil d’Ariane"><a href="{{ routes.root_url }}">Accueil</a><span>/</span><span>{{ page.title | escape }}</span></nav><span class="pc-eyebrow">PLANET COMPUTER · INFORMATIONS UTILES</span><h1>{{ page.title | escape }}</h1><div class="pc-legal__intro">{{ section.settings.intro | escape }}</div><div class="pc-editorial-prose rte">{{ page.content }}</div>{% if section.settings.cookie_controls and settings.pc_cookie_banner %}<button type="button" class="pc-button" data-cookie-open>Gérer mes préférences de cookies</button>{% endif %}<div class="pc-boutiques__note"><p>Une question sur ces informations ? <a href="mailto:{{ settings.pc_contact_email | escape }}">{{ settings.pc_contact_email | escape }}</a></p></div></div></div></section>
{% schema %}{"name":"Page d’information légale","settings":[{"type":"text","id":"intro","label":"Introduction","default":"Retrouvez les informations utiles pour comprendre le fonctionnement de notre boutique et nous contacter."},{"type":"checkbox","id":"cookie_controls","label":"Afficher les préférences cookies","default":false}]}{% endschema %}
