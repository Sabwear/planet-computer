{{ 'pc-editorial.css' | asset_url | stylesheet_tag }}
{{ 'pc-blog.css' | asset_url | stylesheet_tag }}
<section class="pc-section"><div class="pc-container"><nav class="pc-editorial__breadcrumb" aria-label="Fil d’Ariane"><a href="{{ routes.root_url }}">Accueil</a><span>/</span><span>{{ blog.title | escape }}</span></nav><header class="pc-blog__header"><div><span class="pc-eyebrow">LE MAGAZINE PLANET COMPUTER</span><h1>{{ blog.title | escape }}</h1><p>Des repères pratiques pour choisir votre matériel, prendre soin de vos appareils et préparer votre installation informatique à Tanger.</p></div><a class="pc-button pc-button--secondary" href="{{ routes.root_url }}pages/contact">Parlons de votre projet {% render 'pc-icon', name: 'chevron' %}</a></header>
{% if blog.all_tags.size > 0 %}<nav class="pc-blog__tags" aria-label="Sujets du blog"><a href="{{ blog.url }}"{% unless current_tags %} aria-current="page"{% endunless %}>Tous les conseils</a>{% for tag in blog.all_tags %}<a href="{{ blog.url }}/tagged/{{ tag | handleize }}"{% if current_tags contains tag %} aria-current="page"{% endif %}>{{ tag | escape }}</a>{% endfor %}</nav>{% endif %}
{% paginate blog.articles by 9 %}<div class="pc-blog__grid">{% for post in blog.articles %}{% render 'pc-editorial-card', post: post %}{% else %}<p>Les prochains conseils arrivent ici. En attendant, <a href="{{ routes.root_url }}pages/guide-d-achat">consultez notre guide d’achat</a>.</p>{% endfor %}</div>{% if paginate.pages > 1 %}{% render 'pagination', paginate: paginate %}{% endif %}{% endpaginate %}
<div class="pc-blog__cta"><div><span class="pc-eyebrow">DU CONSEIL AU PROJET</span><h2>Votre besoin mérite une réponse précise.</h2><p>Transmettez la référence de votre appareil ou venez nous rencontrer dans l’une de nos deux boutiques à Tanger.</p></div><a class="pc-button" href="{{ routes.root_url }}pages/contact">Nous contacter {% render 'pc-icon', name: 'chevron' %}</a></div></div></section>
{% schema %}{"name":"Blog Planet Computer","settings":[]}{% endschema %}
