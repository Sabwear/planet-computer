{% comment %}Empty by default: no demo content is exposed on the storefront.{% endcomment %}
{% if section.settings.heading != blank %}
  <section class="pc-foundation pc-section">
    <div class="pc-container pc-stack">
      <h1 class="pc-title">{{ section.settings.heading | escape }}</h1>
      {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a class="pc-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}{% render 'pc-icon', name: 'chevron' %}</a>
      {% endif %}
    </div>
  </section>
{% endif %}
{% schema %}
{
  "name": "Fondation Planet Computer",
  "settings": [
    {"type": "text", "id": "heading", "label": "Titre"},
    {"type": "richtext", "id": "text", "label": "Texte"},
    {"type": "text", "id": "button_label", "label": "Libellé du bouton"},
    {"type": "url", "id": "button_link", "label": "Lien du bouton"}
  ],
  "presets": [{"name": "Fondation Planet Computer"}]
}
{% endschema %}
