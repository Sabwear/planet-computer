{% if product != blank %}
{% liquid
  assign variant = product.selected_or_first_available_variant
  assign quick_add = false
  if product.variants.size == 1 and variant.available and product.requires_selling_plan == false and variant.quantity_rule.min <= 1 and variant.quantity_rule.increment <= 1 and product.quantity_price_breaks_configured? != true
    assign quick_add = true
  endif
  assign spec_mode = 'computer'
  assign product_kind = product.type | downcase
  if product_kind contains 'moniteur' or product_kind contains 'écran'
    assign spec_mode = 'monitor'
  elsif product.tags contains 'gaming'
    assign spec_mode = 'gaming'
  endif
%}
<div data-quick-view-content class="pc-quick-view-grid">
  <a href="{{ product.url }}" class="pc-quick-view-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'eager', widths: '320, 480, 800', sizes: '(min-width: 768px) 320px, 200px', alt: product.title }}{% else %}<span>{{ 'pc.product.image_unavailable' | t }}</span>{% endif %}</a>
  <div class="pc-quick-view-info">
    {% if product.vendor != blank and product.vendor != shop.name and product.vendor != 'My Store' %}<p class="pc-eyebrow">{{ product.vendor | escape }}</p>{% endif %}
    <h2 id="PCQuickViewTitle">{{ product.title | escape }}</h2>
    {% render 'product-badges', product: product %}
    <div class="pc-quick-view-purchase">
      <div data-quick-view-price>{% render 'pc-price', product: product %}</div>
      {% render 'pc-availability', variant: variant %}
    </div>
    {% render 'specs-chips', product: product, mode: spec_mode %}
    <div class="pc-quick-view-actions">
      {% if quick_add %}{% render 'pc-card-add', product: product, variant: variant %}{% elsif variant.available %}<a class="pc-button" href="{{ product.url }}">Choisir ma configuration</a>{% endif %}
      {% if quick_add %}{% render 'pc-whatsapp-order', product: product %}{% endif %}
    </div>
    <a class="pc-quick-view-details" href="{{ product.url }}">{{ 'pc.product.full_details' | t }} {% render 'pc-icon', name: 'chevron' %}</a>
  </div>
</div>
{% endif %}
{% schema %}{"name":"Aperçu rapide","settings":[]}{% endschema %}
