{% if section.settings.collection != blank and section.settings.collection.products.size > 0 %}
  {{ 'product-card.css' | asset_url | stylesheet_tag }}
  {{ 'homepage.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'carousel.js' | asset_url }}" defer="defer"></script>
  <section class="pc-section pc-products pc-products--{{ section.settings.background }}" style="padding-block: {{ section.settings.spacing }}px">
    <div class="pc-container">
      <div class="pc-products__heading">{% if section.settings.heading != blank %}<h2 class="pc-section-heading">{{ section.settings.heading | escape }}</h2>{% endif %}{% if section.settings.show_all %}<a class="pc-text-link" href="{{ section.settings.collection.url }}">{{ 'pc.home.view_all' | t }}</a>{% endif %}</div>
      {% if section.settings.banner_desktop != blank or section.settings.banner_mobile != blank %}<div class="pc-product-banner">{% render 'pc-campaign-image', desktop_image: section.settings.banner_desktop, mobile_image: section.settings.banner_mobile, alt: section.settings.banner_alt, sizes: '90vw' %}</div>{% endif %}
      {% if section.settings.carousel %}<pc-carousel><div class="pc-carousel__controls" data-controls hidden><button data-prev type="button" aria-label="{{ 'pc.home.previous' | t }} {{ section.settings.heading | escape }}" aria-controls="PCRow-{{ section.id }}">{% render 'pc-icon', name: 'chevron' %}</button><button data-next type="button" aria-label="{{ 'pc.home.next' | t }} {{ section.settings.heading | escape }}" aria-controls="PCRow-{{ section.id }}">{% render 'pc-icon', name: 'chevron' %}</button></div>{% endif %}
      <div {% if section.settings.carousel %}id="PCRow-{{ section.id }}" class="pc-product-row" data-row tabindex="0" role="region" aria-label="{{ section.settings.heading | default: section.settings.collection.title | escape }}"{% else %}class="pc-grid"{% endif %}>
        {% for product in section.settings.collection.products limit: section.settings.maximum %}
          {% render 'pc-product-card', product: product, mode: section.settings.spec_mode, show_price: section.settings.show_price, quick_add: section.settings.quick_add %}
        {% endfor %}
      </div>
      {% if section.settings.carousel %}</pc-carousel>{% endif %}
    </div>
  </section>
{% endif %}
{% schema %}
{
  "name": "Produits Planet Computer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "maximum",
      "label": "Nombre maximum",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "spec_mode",
      "label": "Spécifications prioritaires",
      "options": [
        {
          "value": "computer",
          "label": "Ordinateurs"
        },
        {
          "value": "gaming",
          "label": "Gaming"
        },
        {
          "value": "monitor",
          "label": "Moniteurs"
        }
      ],
      "default": "computer"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Afficher les prix",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "quick_add",
      "label": "Ajout rapide",
      "default": true
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Espacement vertical",
      "min": 16,
      "max": 64,
      "step": 8,
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "carousel",
      "label": "Défilement horizontal",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_all",
      "label": "Lien vers la collection",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        {
          "value": "plain",
          "label": "Blanc"
        },
        {
          "value": "soft",
          "label": "Neutre"
        },
        {
          "value": "deals",
          "label": "Mise en avant"
        }
      ],
      "default": "plain"
    },
    {
      "type": "image_picker",
      "id": "banner_desktop",
      "label": "Bannière ordinateur"
    },
    {
      "type": "image_picker",
      "id": "banner_mobile",
      "label": "Bannière mobile"
    },
    {
      "type": "text",
      "id": "banner_alt",
      "label": "Description bannière"
    }
  ],
  "presets": [
    {
      "name": "Produits Planet Computer"
    }
  ]
}
{% endschema %}
