{% if section.blocks.size > 0 %}
  {{ 'header.css' | asset_url | stylesheet_tag }}
  <div class="pc-announcements pc-announcements--{{ section.settings.style }}">
    <div class="pc-container pc-announcements__row">
      {% for block in section.blocks %}
        {% if block.settings.text != blank %}
          <div {{ block.shopify_attributes }}>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{% else %}<p>{{ block.settings.text | escape }}</p>{% endif %}</div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}
{% schema %}
{
  "name": "Annonces Planet Computer",
  "enabled_on": {"groups": ["header"]},
  "max_blocks": 3,
  "settings": [{"type": "paragraph", "content": "Publiez uniquement des informations et services confirmés."}, {"type":"select","id":"style","label":"Style du bandeau","default":"navy","options":[{"value":"navy","label":"Bleu nuit"},{"value":"accent","label":"Rouge promotionnel"}]}],
  "blocks": [{"type": "announcement", "name": "Annonce", "settings": [{"type": "text", "id": "text", "label": "Message confirmé"}, {"type": "url", "id": "link", "label": "Lien"}]}],
  "presets": [{"name": "Annonces Planet Computer"}]
}
{% endschema %}
