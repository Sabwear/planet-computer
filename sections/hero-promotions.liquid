{{ 'homepage.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'pc-retail-motion.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'carousel.js' | asset_url }}" defer="defer"></script>
{% if section.settings.heading != blank or section.settings.desktop_image != blank or section.settings.mobile_image != blank %}
  <section class="pc-hero pc-section" style="padding-block: {{ section.settings.spacing }}px">
    <div class="pc-container pc-hero__grid">
      <pc-carousel class="pc-hero-slider"><div class="pc-hero-slides" id="PCHero-{{ section.id }}" data-row tabindex="0" role="region" aria-label="{{ 'pc.home.hero_slides' | t }}">
      <div class="pc-hero__main pc-hero-slide{% if section.settings.campaign_photo != blank and section.settings.campaign_photo != 'none' %} pc-hero__main--photo{% endif %}">
        <div class="pc-hero__content pc-stack">
          {% if section.settings.eyebrow != blank %}<p class="pc-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
          <h1 class="pc-title">{{ section.settings.heading | default: shop.name | escape }}</h1>
          {% if section.settings.text != blank %}<div class="rte pc-muted">{{ section.settings.text }}</div>{% endif %}
          {% if section.settings.button_label != blank and section.settings.button_link != blank %}<a class="pc-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}
          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}<a class="pc-button pc-button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
        </div>
        {% if section.settings.campaign_photo != blank and section.settings.campaign_photo != 'none' and section.settings.desktop_image == blank and section.settings.mobile_image == blank %}{% render 'pc-retail-photo', photo: section.settings.campaign_photo, eager: true %}{% elsif section.settings.editorial_art and section.settings.desktop_image == blank and section.settings.mobile_image == blank %}<img class="pc-editorial-art" src="{{ 'pc-editorial-devices.webp' | asset_url }}" width="1536" height="1024" alt="" fetchpriority="high">{% else %}{% render 'pc-campaign-image', desktop_image: section.settings.desktop_image, mobile_image: section.settings.mobile_image, alt: section.settings.image_alt, sizes: '(min-width: 1024px) 40vw, 90vw', eager: true %}{% endif %}
      </div>
{% for block in section.blocks %}{% if block.type == 'slide' %}{% render 'pc-hero-slide', campaign: block.settings, attributes: block.shopify_attributes %}{% endif %}{% endfor %}
      </div><div class="pc-carousel__controls pc-hero-slider__controls" data-controls hidden><button type="button" data-prev aria-label="{{ 'pc.home.previous' | t }}" aria-controls="PCHero-{{ section.id }}">{% render 'pc-icon', name: 'chevron' %}</button><button type="button" data-next aria-label="{{ 'pc.home.next' | t }}" aria-controls="PCHero-{{ section.id }}">{% render 'pc-icon', name: 'chevron' %}</button></div></pc-carousel>
      {% capture hero_tiles %}
        {% for block in section.blocks %}
          {% if block.type == 'campaign' %}{% if block.settings.heading != blank or block.settings.desktop_image != blank or block.settings.mobile_image != blank %}
            <article class="pc-campaign-tile{% if block.settings.campaign_photo != blank and block.settings.campaign_photo != 'none' %} pc-campaign-tile--photo pc-campaign-tile--{{ block.settings.campaign_photo }}{% endif %}" {{ block.shopify_attributes }}>
              {% if block.settings.desktop_image != blank or block.settings.mobile_image != blank %}{% render 'pc-campaign-image', desktop_image: block.settings.desktop_image, mobile_image: block.settings.mobile_image, alt: block.settings.image_alt, sizes: '(min-width: 1024px) 25vw, 90vw' %}{% else %}{% render 'pc-retail-photo', photo: block.settings.campaign_photo %}{% endif %}
              <div class="pc-campaign-tile__content pc-stack">
                {% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}
                {% if block.settings.text != blank %}<p class="pc-muted">{{ block.settings.text | escape }}</p>{% endif %}
                {% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="pc-text-link" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}{% render 'pc-icon', name: 'chevron' %}</a>{% endif %}
              </div>
            </article>
          {% endif %}
        {% endif %}{% endfor %}
      {% endcapture %}{% if hero_tiles != blank %}<div class="pc-hero__side">{{ hero_tiles }}</div>{% endif %}
    </div>
  </section>
{% else %}<h1 class="visually-hidden">{{ shop.name | escape }}</h1>{% endif %}
