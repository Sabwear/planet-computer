{{ 'homepage.css' | asset_url | stylesheet_tag }}
{% if section.settings.heading != blank or section.settings.desktop_image != blank or section.settings.mobile_image != blank %}
  <section class="pc-hero pc-section" style="padding-block: {{ section.settings.spacing }}px">
    <div class="pc-container pc-hero__grid">
      <div class="pc-hero__main">
        <div class="pc-hero__content pc-stack">
          {% if section.settings.eyebrow != blank %}<p class="pc-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
          <h1 class="pc-title">{{ section.settings.heading | default: shop.name | escape }}</h1>
          {% if section.settings.text != blank %}<div class="rte pc-muted">{{ section.settings.text }}</div>{% endif %}
          {% if section.settings.button_label != blank and section.settings.button_link != blank %}<a class="pc-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}
          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}<a class="pc-button pc-button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
        </div>
        {% if section.settings.editorial_art and section.settings.desktop_image == blank and section.settings.mobile_image == blank %}<img class="pc-editorial-art" src="{{ 'pc-editorial-devices.webp' | asset_url }}" width="1536" height="1024" alt="" fetchpriority="high">{% else %}{% render 'pc-campaign-image', desktop_image: section.settings.desktop_image, mobile_image: section.settings.mobile_image, alt: section.settings.image_alt, sizes: '(min-width: 1024px) 40vw, 90vw', eager: true %}{% endif %}
      </div>
      {% capture hero_tiles %}
        {% for block in section.blocks %}
          {% if block.settings.heading != blank or block.settings.desktop_image != blank or block.settings.mobile_image != blank %}
            <article class="pc-campaign-tile" {{ block.shopify_attributes }}>
              {% render 'pc-campaign-image', desktop_image: block.settings.desktop_image, mobile_image: block.settings.mobile_image, alt: block.settings.image_alt, sizes: '(min-width: 1024px) 25vw, 90vw' %}
              <div class="pc-campaign-tile__content pc-stack">
                {% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}
                {% if block.settings.text != blank %}<p class="pc-muted">{{ block.settings.text | escape }}</p>{% endif %}
                {% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="pc-text-link" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}{% render 'pc-icon', name: 'chevron' %}</a>{% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      {% endcapture %}{% if hero_tiles != blank %}<div class="pc-hero__side">{{ hero_tiles }}</div>{% endif %}
    </div>
  </section>
{% else %}<h1 class="visually-hidden">{{ shop.name | escape }}</h1>{% endif %}
{% schema %}
{
  "name": "Hero Planet Computer",
  "max_blocks": 2,
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [{"type":"checkbox","id":"editorial_art","label":"Illustration conceptuelle (sans produit réel)","default":false},
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Image ordinateur"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image mobile"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Description de l’image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre principal"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton principal"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien principal"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Bouton secondaire"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Lien secondaire"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Espacement",
      "min": 16,
      "max": 64,
      "step": 8,
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "campaign",
      "name": "Campagne secondaire",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Image ordinateur"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Image mobile"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Description de l’image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Titre"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Bouton"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Planet Computer"
    }
  ],
  "limit": 1
}
{% endschema %}
