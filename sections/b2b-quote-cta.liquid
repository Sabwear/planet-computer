{% if section.settings.enabled and section.settings.heading != blank and section.settings.button_link != blank %}
  {{ 'homepage.css' | asset_url | stylesheet_tag }}
  <section class="pc-section" style="padding-block: {{ section.settings.spacing }}px"><div class="pc-container"><div class="pc-b2b">
    <div class="pc-stack"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}</div>
    {% if section.settings.button_label != blank %}<a class="pc-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}
  </div></div></section>
{% endif %}
{% schema %}
{
  "name": "Devis professionnel",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Activer",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte confirmé"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Page de demande de devis"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Espacement",
      "min": 16,
      "max": 64,
      "step": 8,
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Devis professionnel"
    }
  ]
}
{% endschema %}
