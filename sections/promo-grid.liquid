{% capture tiles %}{% for block in section.blocks %}{% if block.settings.heading != blank or block.settings.desktop_image != blank or block.settings.mobile_image != blank %}
  <article class="pc-campaign-tile" {{ block.shopify_attributes }}>
    {% render 'pc-campaign-image', desktop_image: block.settings.desktop_image, mobile_image: block.settings.mobile_image, alt: block.settings.image_alt, sizes: '(min-width: 768px) 30vw, 90vw' %}
    <div class="pc-campaign-tile__content pc-stack">
      {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
      {% if block.settings.text != blank %}<p class="pc-muted">{{ block.settings.text | escape }}</p>{% endif %}
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="pc-text-link" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}{% render 'pc-icon', name: 'chevron' %}</a>{% endif %}
    </div>
  </article>
{% endif %}{% endfor %}{% endcapture %}
{% if tiles != blank %}
  {{ 'homepage.css' | asset_url | stylesheet_tag }}
  <section class="pc-section" style="padding-block: {{ section.settings.spacing }}px"><div class="pc-container">
    {% if section.settings.heading != blank %}<h2 class="pc-section-heading">{{ section.settings.heading | escape }}</h2>{% endif %}
    <div class="pc-promo-grid">{{ tiles }}</div>
  </div></section>
{% endif %}
{% schema %}
{"name":"Campagnes Planet","max_blocks":3,"settings":[{"type":"text","id":"heading","label":"Titre"},{"type":"range","id":"spacing","label":"Espacement","min":16,"max":64,"step":8,"default":24}],"blocks":[{"type":"campaign","name":"Campagne approuvée","settings":[{"type":"image_picker","id":"desktop_image","label":"Image ordinateur"},{"type":"image_picker","id":"mobile_image","label":"Image mobile"},{"type":"text","id":"image_alt","label":"Description de l’image"},{"type":"text","id":"heading","label":"Titre"},{"type":"text","id":"text","label":"Texte"},{"type":"text","id":"button_label","label":"Bouton"},{"type":"url","id":"button_link","label":"Lien"}]}],"presets":[{"name":"Campagnes Planet"}]}
{% endschema %}
